<!-- Date -->
<div class="col-md-2 col-sm-6 col-12">
    <label class="small fw-bold">Date</label>
    <input type="text"
           id="Date"
           name="Date"
           value="@Date"
           class="form-control form-control-sm"
           data-provide="datepicker"
           data-date-autoclose="true"
           data-date-format="dd-M-yyyy">
</div>